rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Allow read/write access to stores collection
    match /stores/{storeId} {
      allow read, write: if true;
    }
    
    // Allow read/write access to users collection
    match /users/{userId} {
      allow read, write: if true;
    }
    
    // Allow read/write access to products catalog
    match /products/{productId} {
      allow read, write: if true;
    }
    
    // Allow read/write access to customer restock alerts
    match /restockAlerts/{alertId} {
      allow read, write: if true;
    }

    // Default open rule for development & staging
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
